      "Page",
      {
        "pages": {
          "/dash": [
            "unquote",
            "@entity.widget"
          ]
        }
      }
    ],
    "ir": [
      "quasiquote",
      "[\"orbital\",\"Page\",{\"pages\":{\"/dash\":[\"unquote\",0]}}]",
      "@entity.widget"
    ],
    "values": [
      "std/std-kanban.traits.KanbanBoard"
    ],
    "result": [
      "orbital",
      "Page",
      {
        "pages": {
          "/dash": "std/std-kanban.traits.KanbanBoard"
        }
      }
    ]
  },
  {
    "name": "object-value-hole",
    "template": {
      "from": "a",
      "widget": [
        "unquote",
        "@entity.w"
      ]
    },
    "ir": [
