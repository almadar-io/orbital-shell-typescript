      "{\"from\":\"a\",\"widget\":[\"unquote\",0]}",
      "@entity.w"
    ],
    "values": [
      {
        "ref": "std/std-kanban.traits.KanbanBoard",
        "config": {
          "compact": true
        }
      }
    ],
    "result": {
      "from": "a",
      "widget": {
        "ref": "std/std-kanban.traits.KanbanBoard",
        "config": {
          "compact": true
        }
      }
    }
  },
  {
    "name": "two-holes-sorted-keys",
    "template": {
      "z": [
        "unquote",
        "@entity.z"
      ],
      "a": [
        "unquote",
        [
          "+",
          "@entity.n",
          1
        ]
      ]
    },
    "ir": [
      "quasiquote",
      "{\"a\":[\"unquote\",0],\"z\":[\"unquote\",1]}",
      [
        "+",
        "@entity.n",
        1
      ],
      "@entity.z"
    ],
    "values": [
      1,
      2
    ],
    "result": {
      "a": 1,
      "z": 2
    }
  },
  {
    "name": "no-hole",
