[
  {
    "name": "single-hole",
    "template": [
      "set",
      "@entity.a",
      [
        "unquote",
        "@payload.v"
      ]
    ],
    "ir": [
      "quasiquote",
      "[\"set\",\"\\u0040entity.a\",[\"unquote\",0]]",
      "@payload.v"
    ],
    "values": [
      42
    ],
    "result": [
      "set",
      "@entity.a",
      42
    ]
  },
  {
    "name": "orbital-import-splice",
    "template": [
