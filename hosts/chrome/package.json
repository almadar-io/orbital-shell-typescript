{
  "name": "@almadar/shell-chrome",
  "version": "0.1.0",
  "description": "Almadar TS shell chrome runtime pack: the Chrome-extension host ports of the kernel (tabs, content script, credentials, on-device model).",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@almadar/core": "^10.128.0",
    "@almadar/kernel": "^18.0.0",
    "@almadar/shell-web": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/orbital-shell-typescript.git",
    "directory": "hosts/chrome"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
