{
  "name": "@almadar/orb-lsp",
  "version": "1.0.0",
  "description": "Language Server Protocol for .orb and .lolo files \u2014 validates via the @almadar/orb CLI",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "orb-lsp": "./bin/orb-lsp.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@almadar/orb": "^2.47.1",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@almadar/core": ">=10.13.0",
    "@almadar/shell-web": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
