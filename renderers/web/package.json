{
  "name": "@almadar/shell-web",
  "version": "0.1.0",
  "description": "Almadar TS shell web renderer pack: the browser host ports of the kernel (transports, stores, client kernel, http/oauth/os ports) and the React render substrate (components, hooks, providers, preview runtime, themes, Tailwind preset) the generated web app and the TS host program import.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "import": "./dist/test-support.js",
      "default": "./dist/test-support.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./core/locales/en.json": "./src/core/locales/en.json",
    "./core/locales/ar.json": "./src/core/locales/ar.json",
    "./core/locales/sl.json": "./src/core/locales/sl.json",
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js",
      "default": "./dist/context/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js",
      "default": "./dist/renderer/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js",
      "default": "./dist/lib/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js",
      "default": "./dist/three/index.js"
    },
    "./avl": {
      "types": "./dist/avl/index.d.ts",
      "import": "./dist/avl/index.js",
      "default": "./dist/avl/index.js"
    },
    "./illustrations": {
      "types": "./dist/avl/index.d.ts",
      "import": "./dist/avl/index.js",
      "default": "./dist/avl/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js",
      "require": "./dist/ssr/index.cjs"
    },
    "./design-classes": {
      "types": "./dist/design-classes/index.d.ts",
      "import": "./dist/design-classes/index.js",
      "require": "./dist/design-classes/index.cjs"
    },
    "./themes/*.css": "./themes/*.css",
    "./index.css": "./index.css",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./tailwind-compile": "./tailwind-compile.cjs",
    "./bundling": {
      "types": "./bundling.d.mts",
      "import": "./bundling.mjs"
    },
    "./package.json": "./package.json",
    "./storage/browser": {
      "types": "./dist/storage/browser/index.d.ts",
      "import": "./dist/storage/browser/index.js",
      "default": "./dist/storage/browser/index.js"
    },
    "./auth/browser": {
      "types": "./dist/auth/browser/index.d.ts",
      "import": "./dist/auth/browser/index.js",
      "default": "./dist/auth/browser/index.js"
    },
    "./auth/react": {
      "types": "./dist/auth/react/index.d.ts",
      "import": "./dist/auth/react/index.js",
      "default": "./dist/auth/react/index.js"
    }
  },
  "files": [
    "dist",
    "src/core/locales",
    "src/core/tokens/native-tokens.json",
    "themes",
    "index.css",
    "tailwind-preset.cjs",
    "tailwind-compile.cjs",
    "bundling.mjs",
    "bundling.d.mts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "build:dev": "NODE_OPTIONS=--max-old-space-size=8192 SHELL_WEB_SKIP_DTS=1 tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "lint": "eslint --no-warn-ignored --max-warnings 0 src",
    "verify:themes": "node scripts/theme-contrast-audit.mjs && node scripts/theme-distinctness-audit.mjs",
    "verify:safelist": "tsx scripts/audit-tailwind-safelist.ts",
    "verify:dist-esm": "node scripts/verify-dist-esm.mjs"
  },
  "dependencies": {
    "@almadar/core": "^10.128.0",
    "@almadar/kernel": "^18.0.0",
