{
  "name": "@almadar/shell-web",
  "version": "0.1.0",
  "description": "Almadar TS shell web runtime pack: the browser host ports of the kernel (transports, stores, client kernel, http/oauth/os ports) that the generated web app and the TS host program import.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "import": "./dist/test-support.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@almadar/core": "^10.128.0",
    "@almadar/kernel": "^18.0.0",
    "@almadar/logger": "^1.18.0"
  },
  "devDependencies": {
    "@almadar/db": "^0.1.5",
    "@types/node": "^20.0.0",
    "fake-indexeddb": "6.2.5",
    "tsup": "^8.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/orbital-shell-typescript.git",
    "directory": "renderers/web"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
