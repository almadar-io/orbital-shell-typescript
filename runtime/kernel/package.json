{
  "name": "@almadar/shell-runtime",
  "version": "1.2.0",
  "orbRelease": { "severity": "normal" },
  "description": "Renderer-neutral kernel adapters and client orchestration for Almadar TypeScript hosts.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@almadar/core": "^11.4.0",
    "@almadar/kernel": "^19.2.0",
    "@almadar/logger": "^2.4.0",
    "@almadar/std": "^17.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/orbital-shell-typescript.git",
    "directory": "runtime/kernel"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
