# ── Server ────────────────────────────────────────────────────────────────
PORT=3030
NODE_ENV=production
# Comma-separated allowlist of browser origins permitted to call the API.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Auth: who @user is ────────────────────────────────────────────────────
# Every request is identified by its verified ID token, or is anonymous; the
# app's own guards decide what an anonymous visitor may do.
# AUTH_PROVIDER=firebase        # firebase (default) | oidc
# firebase: Firebase Auth / Identity Platform, verified with the project below.
# oidc (Auth0, Okta, Keycloak, Cognito, Clerk…): tokens verified against the issuer's keys.
# OIDC_ISSUER_URL=https://your-tenant.example.com/
# OIDC_AUDIENCE=your-api-identifier

# ── Firebase project (auth verification, and the firestore data backend) ──
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# or: FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json

# ── Database ──────────────────────────────────────────────────────────────
# DATA_BACKEND=firebase         # firebase (default) | postgres | couchdb | mock
# DATABASE_URL=postgres://…     # postgres
# PGPOOL_MAX=10                 # postgres (optional)
# COUCHDB_URL=http://…          # couchdb
# USE_MOCK_DATA=true            # LOCAL DEV ONLY: seeded rows in memory, lost on restart

# ── Local dev on the Firebase emulators (never in production) ─────────────
# Personas are the app's [identity] rows signed in as Auth-emulator users.
# FIREBASE_PROJECT_ID=demo-almadar
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#
# The server refuses to start with NODE_ENV=production when the auth config is
# incomplete, an emulator host is set, or USE_MOCK_DATA=true.

# ── Client (packages/client/.env) ─────────────────────────────────────────
# VITE_API_URL=http://localhost:3030
# VITE_APP_FIREBASE_API_KEY=
# VITE_APP_FIREBASE_PROJECT_ID=
# VITE_APP_FIREBASE_AUTH_DOMAIN=
# dev: VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 with VITE_APP_FIREBASE_API_KEY=emulator
#      and VITE_APP_FIREBASE_PROJECT_ID=demo-almadar

# ── Integration keys ──────────────────────────────────────────────────────
# Listed per service in SECRETS.md; a production server refuses to start
# without the required key of any service the app calls.
