{
  "name": "@almadar/shell-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@almadar/core": "^10.128.0",
    "@almadar/shell-node": "^0.1.0",
    "@almadar/std": "^16.255.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@almadar/eslint-plugin": "^2.22.0",
    "@types/node": "^20.17.19",
    "@typescript-eslint/parser": "8.56.0",
    "esbuild": "^0.25.0",
    "eslint": "10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
