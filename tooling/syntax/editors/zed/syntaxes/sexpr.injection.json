{
  "scopeName": "source.orb.sexpr-injection",
  "injectionSelector": "L:source.orb -comment",
  "patterns": [
    {
      "name": "keyword.operator.arithmetic.sexpr",
      "match": "(?<=\")(\\+|-|\\*|/|%)(?=\")"
    },
    {
      "name": "keyword.operator.comparison.sexpr",
      "match": "(?<=\")(==|!=|<=|>=|=|<|>)(?=\")"
    },
    {
      "name": "keyword.operator.logical.sexpr",
      "match": "(?<=\")(and|not|or|if)(?=\")"
    },
    {
      "name": "keyword.control.sexpr",
      "match": "(?<=\")(quasiquote|unquote|quote|list|when|let|do|fn)(?=\")"
    },
    {
      "name": "keyword.other.effect.sexpr",
      "match": "(?<=\")(oauth-connection-status|oauth-connection-forget|credential-status|credential-forget|oauth-authorize|navigate-back|fetch-stream|call-service|random-bytes|send-server|cancel-call|render-ui|navigate|persist|despawn|notify|atomic|spawn|fetch|deref|watch|emit|swap|http|set|log|ref)(?=\")"
    },
