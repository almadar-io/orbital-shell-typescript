{
  "name": "@almadar/syntax",
  "version": "1.21.0",
  "description": "Registry-driven syntax highlighting for Orb programs. Colors align with AVL visual language.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    },
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "tsx scripts/generate-tokens.ts",
    "build": "tsup && pnpm run generate-grammar",
    "test": "vitest run",
    "build:full": "npm run generate && tsup && pnpm run generate-grammar",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "prepare": "git config core.hooksPath .githooks",
    "generate-grammar": "tsx scripts/build-grammars.ts",
    "check:zed": "tsx scripts/check-zed-extension.ts",
    "build:editors": "pnpm run build:lsp && pnpm run build:vscode && pnpm run build:zed",
    "build:lsp": "cd lsp && npm install --ignore-scripts --loglevel=error && npx tsup",
    "build:vscode": "cd editors/vscode && npm install --ignore-scripts --loglevel=error && node esbuild.js && cp ../../dist/sexpr.injection.json syntaxes/sexpr.injection.json && cp ../../dist/lolo.tmLanguage.json syntaxes/lolo.tmLanguage.json && cp ../../lsp/dist/server.js dist/server.js",
    "build:zed": "mkdir -p editors/zed/syntaxes && cp dist/sexpr.injection.json editors/zed/syntaxes/sexpr.injection.json"
  },
  "dependencies": {
    "@almadar/core": "^10.128.0",
    "@almadar/std": "^16.253.0"
  },
  "devDependencies": {
    "@almadar/eslint-plugin": "^2.22.0",
    "@almadar/lolo-ar": "^1.3.0",
    "@almadar/lolo-sl": "^1.3.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.7.0",
    "turbo": "^2.8.17",
    "vitest": "^4.1.12",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/almadar-io/orbital-shell-typescript.git",
    "directory": "tooling/syntax"
  },
  "license": "BSL-1.1",
  "homepage": "https://github.com/almadar-io/almadar#readme",
  "packageManager": "pnpm@10.30.3"
}
